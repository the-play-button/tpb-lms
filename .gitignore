# Dependencies
node_modules/
.pnpm-store/

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
*.so
.venv/
venv/
ENV/
# env/<target>.public.json = tracked public-env manifests (§ PUBLIC-ENV) — not a Python venv;
# needed explicitly because git ignores case on macOS and ENV/ would match env/.
!env/
!env/*.public.json

# Cloudflare Wrangler
.wrangler/
.dev.vars

# Environment files
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
._*

# Build outputs
dist/
build/
*.log

# Test coverage
coverage/
.nyc_output/

# Secrets and credentials
*.pem
*.key
secrets/

# Temporary files
tmp/
temp/
*.tmp

# Backup files with secrets
**/backup_before_iam_migration.yaml
*.backup.yaml
package-lock.json

# Skool lesson file attachments (course content) — deployed as viewer static assets, mastered in the skool mirror
frontend-on-cf-worker/resources/

# § PUBLIC-ENV — generated from backend/wrangler.template.toml + env/<env>.public.json
backend/wrangler-dev.toml
backend/wrangler-staging.toml
backend/wrangler-production.toml

# eslint cache written by the pre-push hook
.eslintcache
